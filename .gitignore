# Vivy_final — GitHub-ready ignore (2026-09-26)
# Rule: repo holds CODE + SPEC + text evidence only. Never weights, secrets, caches, binaries.

# ── Secrets (MUST never commit) ─────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets.*
credentials.*

# ── Model weights / checkpoints (GitHub blocks >100 MB) ─────────
*.pt
*.pth
*.bin
*.gguf
*.safetensors
*.ckpt
*.onnx

# ── Numpy / expert payloads (internal store only) ───────────────
*.npy
*.npz

# ── Internal checkpoint store (see docs/CHECKPOINTS.md) ─────────
internal/

# ── Native build binaries (rebuild from engine/src/) ────────────
engine/bin/*.exe
engine/bin/*.dll
engine/bin/*.so
engine/bin/*.dylib
*.exe
!engine/bin/.gitkeep

# ── Python / tooling caches ─────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
_pytest_tmp/
.venv/
venv/
env/
ENV/
htmlcov/
.coverage
.coverage.*
coverage.xml
.tox/

# ── Node / UI build output ──────────────────────────────────────
node_modules/
dist/
build/
target/
ui/**/out/
ui/**/.next/
*.tsbuildinfo

# ── Editor / OS noise ───────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Local runtime artifacts ─────────────────────────────────────
*.log
*.tmp
*.bak
*.bak.*
scratchpad/
context_store.db
.vivy_activity.jsonl
.vivy_last_response.json
.vivy_session_*.json

# ── llama.cpp prebuilt binaries ─────────────────────────────────
llama.cpp/
llama-server.exe
llama-cli.exe

# ── Experiment data & results (internal, not for public repo) ───
experiment_results_*.json
experiments/
benchmarks/results/
*.jsonl

# ── Build / dist artifacts ──────────────────────────────────────
unitary_reasoner.egg-info/
*.whl
*.tar.gz

# ── Internal working docs (prompts, delegation contracts, plans) ─
docs/claude_prompt_*.txt
docs/codex_prompt_*.txt
DELEGATION_CONTRACT_*.md
PLAN_*.md
PLAN_3DAY.md
PLAN_PHASE0.md
